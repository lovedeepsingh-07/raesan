{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "raesan",
  "version": "0.1.0",
  "identifier": "com.raesan.dev",
  "build": {
    "beforeDevCommand": "yarn run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "yarn run build",
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "raesan",
        "label": "main",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "$schema": "../gen/schemas/desktop-schema.json",
          "identifier": "default",
          "description": "Capability for the main window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
